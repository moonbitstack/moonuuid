//- Shared mixins. `highlight` is supplied by build.mjs.

mixin snippet(item)
  .snippet
    .snippet__head
      span.snippet__lang= item.caption || item.lang
      button.snippet__copy(type="button" data-copy="snippet") Copy
    pre
      code(class="lang-" + item.lang)!= highlight(item.code, item.lang)
  if item.out
    .out
      .out__label prints
      pre
        code= item.out
  if item.note
    p.guide-note= item.note

