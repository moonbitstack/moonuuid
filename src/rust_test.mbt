///|
test "rust: what it refuses is refused here" {
  assert_false(
    try {
      ignore(@moonuuid.parse(""))
      true
    } catch {
      _ => false
    },
  )
  assert_false(
    try {
      ignore(@moonuuid.parse("c232ab00"))
      true
    } catch {
      _ => false
    },
  )
  assert_false(
    try {
      ignore(@moonuuid.parse("not-a-uuid"))
      true
    } catch {
      _ => false
    },
  )
  assert_false(
    try {
      ignore(@moonuuid.parse("c232ab00-9414-11ec-b3c8-9f6bdeced84g"))
      true
    } catch {
      _ => false
    },
  )
}
