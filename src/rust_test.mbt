test "rust: reads one of its own, 00000000-0000-4000-8000-000000000000" {
  let u = @moonuuid.parse("00000000-0000-4000-8000-000000000000")
  assert_eq(u.to_string(), "00000000-0000-4000-8000-000000000000")
  assert_eq(u.hex(), "00000000000040008000000000000000")
  assert_eq(u.urn(), "urn:uuid:00000000-0000-4000-8000-000000000000")
  assert_eq(u.version(), Some(4))
  assert_eq(u.variant(), @moonuuid.Rfc)
}

