// Generated by scripts/gen_vectors.py from the uuid crate implementation. Do not edit.

///|
test "rust: the same input gives the same identifier" {
  let ticks = 0x1EC9414C232AB00L
  assert_eq(
    @moonuuid.v1(ticks~, clock_seq=0x33C8, node=0x9F6BDECED846L).to_string(),
    "c232ab00-9414-11ec-b3c8-9f6bdeced846",
  )
  let ticks = 0x1EC9414C232AB00L
  assert_eq(
    @moonuuid.v6(ticks~, clock_seq=0x33C8, node=0x9F6BDECED846L).to_string(),
    "1ec9414c-232a-6b00-b3c8-9f6bdeced846",
  )
  assert_eq(
    @moonuuid.v3(@moonuuid.namespace_dns, "www.example.com").to_string(),
    "5df41881-3aed-3515-88a7-2f4a814cf09e",
  )
  assert_eq(
    @moonuuid.v5(@moonuuid.namespace_dns, "www.example.com").to_string(),
    "2ed6657d-e927-568b-95e1-2665a8aea6a2",
  )
  assert_eq(
    @moonuuid.v5(@moonuuid.namespace_url, "https://example.org/").to_string(),
    "527dda32-a0de-5105-a042-cb475b5f7d11",
  )
  assert_eq(
    @moonuuid.v4(Bytes::make(16, 0)).to_string(),
    "00000000-0000-4000-8000-000000000000",
  )
  assert_eq(
    @moonuuid.v4(Bytes::makei(16, i => i.to_byte())).to_string(),
    "00010203-0405-4607-8809-0a0b0c0d0e0f",
  )
  assert_eq(
    @moonuuid.v8(Bytes::makei(16, i => i.to_byte())).to_string(),
    "00010203-0405-8607-8809-0a0b0c0d0e0f",
  )
}

///|
test "rust: reads an identifier it was given, 00000000-0000-0000-0000-000000000000" {
  let u = @moonuuid.parse("00000000-0000-0000-0000-000000000000")
  assert_eq(u.to_string(), "00000000-0000-0000-0000-000000000000")
  assert_eq(u.hex(), "00000000000000000000000000000000")
  assert_eq(u.urn(), "urn:uuid:00000000-0000-0000-0000-000000000000")
  assert_eq(u.version(), None)
  assert_eq(u.variant(), @moonuuid.Ncs)
}

